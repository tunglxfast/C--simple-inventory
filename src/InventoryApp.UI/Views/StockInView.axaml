<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InventoryApp.UI.ViewModels"
             x:Class="InventoryApp.UI.Views.StockInView"
             x:DataType="vm:StockInViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" ColumnDefinitions="*">
    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
      <Button Content="← Dashboard" Command="{Binding BackCommand}"/>
      <TextBlock Text="Phiếu Nhập (bản thô)" FontSize="20" FontWeight="Bold"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
      <DatePicker SelectedDate="{Binding DocDate}" />
      <TextBox Width="260" Watermark="Ghi chú" Text="{Binding Note}"/>
      <Button Content="Tạo phiếu nháp" Command="{Binding CreateDraftCommand}"/>
      <TextBlock Text="{Binding DocNo}" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
      <Button Content="Nạp sản phẩm" Command="{Binding LoadProductsCommand}"/>
      <ComboBox Width="220" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Code}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <NumericUpDown Width="120" Minimum="1" Value="{Binding Qty}"/>
      <Button Content="Thêm dòng" Command="{Binding AddItemCommand}"/>
      <Button Content="Xác nhận" Command="{Binding ConfirmCommand}"/>
    </StackPanel>

    <DataGrid Grid.Row="3" AutoGenerateColumns="False" ItemsSource="{Binding Items}" Margin="0,0,0,10">
      <DataGrid.Columns>
        <DataGridTextColumn Header="ProductId" Binding="{Binding ProductId}" Width="120"/>
        <DataGridTextColumn Header="Số lượng" Binding="{Binding Qty}" Width="120"/>
        <DataGridTextColumn Header="Nghiệp vụ" Binding="{Binding StockEffectType}" Width="120"/>
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock Grid.Row="4" Text="{Binding Message}" TextWrapping="Wrap"/>
  </Grid>
</UserControl>
