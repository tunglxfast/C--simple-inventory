<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:InventoryApp.UI.ViewModels"
             x:Class="InventoryApp.UI.Views.ProductView"
             x:DataType="vm:ProductViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="*,*">
    <StackPanel Orientation="Horizontal" Spacing="8" Grid.ColumnSpan="2" Margin="0,0,0,10">
      <Button Content="← Dashboard" Command="{Binding BackCommand}"/>
      <TextBlock Text="Quản lý sản phẩm" FontWeight="Bold" FontSize="20" VerticalAlignment="Center"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Grid.ColumnSpan="2" Margin="0,0,0,10">
      <TextBox Width="280" Watermark="Tìm theo mã/tên" Text="{Binding Keyword}"/>
      <Button Content="Tải danh sách" Command="{Binding LoadCommand}"/>
    </StackPanel>

    <DataGrid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10"
              ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
              AutoGenerateColumns="False" Height="260" IsReadOnly="True">
      <DataGrid.Columns>
        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
        <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="140"/>
        <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="240"/>
        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100"/>
        <DataGridTextColumn Header="Nhóm" Binding="{Binding Category}" Width="140"/>
        <DataGridTextColumn Header="ĐVT" Binding="{Binding Unit}" Width="100"/>
      </DataGrid.Columns>
    </DataGrid>

    <Border Grid.Row="3" Grid.Column="0" Padding="12" CornerRadius="10" Background="#112E7D32" Margin="0,0,8,0">
      <StackPanel Spacing="8">
        <TextBlock Text="Thêm / Sửa sản phẩm" FontWeight="SemiBold"/>
        <TextBox Watermark="Mã" Text="{Binding Code}"/>
        <TextBox Watermark="Tên" Text="{Binding Name}"/>
        <TextBox Watermark="ĐVT" Text="{Binding Unit}"/>
        <TextBox Watermark="Size" Text="{Binding Size}"/>
        <TextBox Watermark="Nhóm" Text="{Binding Category}"/>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Thêm" Command="{Binding AddCommand}"/>
          <Button Content="Cập nhật" Command="{Binding UpdateCommand}"/>
          <Button Content="Xóa" Command="{Binding DeleteCommand}"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="3" Grid.Column="1" Padding="12" CornerRadius="10" Background="#111E88E5" Margin="8,0,0,0">
      <StackPanel Spacing="8">
        <TextBlock Text="Đổi mã sản phẩm" FontWeight="SemiBold"/>
        <TextBox Watermark="Mã mới" Text="{Binding NewCode}"/>
        <Button Content="Đổi mã" Command="{Binding ChangeCodeCommand}" Width="120"/>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
